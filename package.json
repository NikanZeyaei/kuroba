{
	"name": "kuroba",
	"version": "0.0.3",
	"description": "A type-safe TypeScript API client for 4chan and imageboards",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"browser": "./dist/index.js",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/NikanZeyaei/kuroba"
	},
	"bugs": {
		"url": "https://github.com/NikanZeyaei/kuroba/issues"
	},
	"homepage": "https://github.com/NikanZeyaei/kuroba#readme",
	"scripts": {
		"build": "tsc",
		"prepack": "pnpm build",
		"change": "changeset",
		"version": "changeset version",
		"release": "changeset publish",
		"test": "pnpm build && node --test 'test/**/*.test.ts'",
		"typecheck": "pnpm build && tsc -p tsconfig.test.json",
		"lint:fix": "biome lint --write .",
		"format": "biome format .",
		"format:write": "biome format --write .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"prepare": "lefthook install"
	},
	"packageManager": "pnpm@12.3.4",
	"keywords": [
		"4chan",
		"imageboard",
		"api-client",
		"typescript"
	],
	"engines": {
		"node": ">=22.0.0"
	},
	"author": "nikanzeyaei",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.2",
		"@types/node": "^26.5.0",
		"lefthook": "^2.1.12",
		"typescript": "^7.0.2"
	}
}
