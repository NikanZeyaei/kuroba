{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"preset": "recommended",
				"noBannedTypes": "error",
				"noUselessCatch": "error"
			},
			"correctness": {
				"preset": "recommended"
			},
			"performance": {
				"preset": "recommended",
				"noAccumulatingSpread": "warn"
			},
			"security": {
				"preset": "recommended"
			},
			"style": {
				"preset": "recommended",
				"noNonNullAssertion": "warn",
				"noParameterAssign": "error",
				"useConsistentArrayType": {
					"level": "error",
					"options": {
						"syntax": "shorthand"
					}
				},
				"useExportType": "error",
				"useImportType": "error"
			},
			"suspicious": {
				"preset": "recommended",
				"noConsole": "warn",
				"noDoubleEquals": "on",
				"noEvolvingTypes": "error",
				"noExplicitAny": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		},
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		},
		"enabled": true
	}
}
